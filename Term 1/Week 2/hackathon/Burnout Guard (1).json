    {
      "parameters": {
        "jsCode": "// Get raw text output from the Gemini AI node\nlet rawText = $input.first().json.text || \"\";\n\n// Strip away markdown code block fences if Gemini adds them (e.g. ```json ... ```)\nrawText = rawText.replace(/```json/gi, '').replace(/```/gi, '').trim();\n\ntry {\n  // Parse string into a true JSON object\n  const parsedJSON = JSON.parse(rawText);\n  return [{ json: parsedJSON }];\n} catch (error) {\n  // Demo Safety Net: If AI formatting glitches, fall back gracefully instead of breaking\n  return [{\n    json: {\n      risk_level: \"High\",\n      email: {\n        title: \"Daily Health Briefing\",\n        body: rawText\n      }\n    }\n  }];\n}"
      },
